NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_TALENT_AGENT_ADDRESS=
# x402 settlement network for the escrow rail. One of the canonical USDC
# deployments in src/lib/usdc.ts (base | ethereum | optimism | arbitrum |
# polygon | avalanche | monad | baseSepolia | sepolia) or a QUAI network in
# src/lib/quai.ts (quai | quaiOrchard). Defaults to base.
NEXT_PUBLIC_X402_NETWORK=base

# --- QUAI x402 rail ---------------------------------------------------------
# TalentAgentQuai escrow on QUAI (Cyprus-1 shard, 0x00... address).
#   Orchard (15000): 0x0042bc0BBbe34FBa82a52Cce6a2792DaA87c484C
#   Mainnet (9):     0x00558035cfFAa4766A7f77cA987650711bDaF7a6
NEXT_PUBLIC_TALENT_AGENT_QUAI_ADDRESS=
# Allowlisted settlement token (bridged USDT / WQI) per QUAI network.
#   Mainnet USDT:    0x0049F7cbCa3556C2DfaE62Aafa7015F99de1b8f5
#   Orchard test:    0x0043a6b95A33A5Ac6ece32A4C172AE83390c2C59
NEXT_PUBLIC_QUAI_SETTLEMENT_TOKEN=
NEXT_PUBLIC_QUAI_ORCHARD_SETTLEMENT_TOKEN=
