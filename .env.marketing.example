# ============================================
# BoltPromoter AI Marketing Agent — Environment
# ============================================
# Copy this file to .env.marketing and fill in your credentials.
# Only configure the platforms you want active.

# ---- LLM & TTS Provider (REQUIRED) ----
OPENAI_API_KEY=sk-...

# ---- Discord (Optional) ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_IDS=              # Comma-separated guild IDs
DISCORD_VOICE_ENABLED=true      # Join voice channels and speak via TTS

# ---- Reddit (Optional) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USERNAME=

# ---- Twitter / X (Optional) ----
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---- Telegram (Optional) ----
TELEGRAM_BOT_TOKEN=

# ---- Agent Configuration ----
MARKETING_AGENT_NAME=BoltPromoter
MARKETING_VOICE_PERSONA=ChillProducer   # ChillProducer | HypeCaster | TechEvangelist
MARKETING_VOICE_ID=onyx                 # OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
MARKETING_POST_FREQUENCY=optimal        # conservative | optimal | aggressive
MARKETING_TIMEZONE=UTC                  # IANA timezone for scheduling

# ---- Target Subreddits ----
MARKETING_SUBREDDITS=WeAreTheMusicMakers,edmproduction,MusicBattlestations,synthesizers,Web3,cryptocurrency,gamedev,VRchat

# ---- Harness Connection ----
HARNESS_URL=ws://localhost:3700

# ---- Analytics ----
MARKETING_DB_PATH=marketing_analytics.db
