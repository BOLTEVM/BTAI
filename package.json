{
    "name": "btai-monorepo",
    "private": true,
    "scripts": {
        "dev:frontend": "pnpm --filter frontend dev",
        "dev:backend": "python -m uvicorn main:app --reload --app-dir apps/backend",
        "build": "pnpm -r build",
        "start:frontend": "pnpm --filter frontend start",
        "start:backend": "python -m uvicorn main:app --app-dir apps/backend",
        "lint": "pnpm --filter frontend lint",
        "test": "pnpm -r test",
        "test:contracts": "pnpm --filter contracts test",
        "test:fuzz": "pnpm --filter contracts test:fuzz",
        "test:facilitator": "pnpm --filter facilitator test",
        "test:backend": "cd apps/backend && python -m pytest test_api.py -q",
        "test:all": "pnpm test:contracts && pnpm test:fuzz && pnpm test:facilitator && pnpm test:backend && pnpm --filter frontend build",
        "slither": "slither packages/contracts/contracts/TestSettlementToken.sol"
    },
    "devDependencies": {
        "turbo": "latest"
    }
}
