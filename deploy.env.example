# Dark Star Rail backend stack — deployment environment template.
# Copy to .env for docker compose, or translate into your platform's env/secret UI.
# Values below are the LIVE deployments; Orchard (testnet) alternatives in comments.

# ---- shared -----------------------------------------------------------------
# TalentAgentQuai escrow. Mainnet Cyprus-1 (eip155:9) / Orchard (eip155:15000):
ESCROW_ADDRESS=0x00558035cfFAa4766A7f77cA987650711bDaF7a6
# ESCROW_ADDRESS=0x0042bc0BBbe34FBa82a52Cce6a2792DaA87c484C
X402_NETWORK=eip155:9
# X402_NETWORK=eip155:15000

# ---- talent API (apps/backend) ----------------------------------------------
# REQUIRED for the deployed site: the exact frontend origin, comma-separated if several.
BTAI_ALLOWED_ORIGINS=https://darkcircle.si
# Settlement token allowlisted on the escrow. Mainnet bridged USDT / Orchard test token:
SETTLEMENT_TOKEN=0x0049F7cbCa3556C2DfaE62Aafa7015F99de1b8f5
# SETTLEMENT_TOKEN=0x0043a6b95A33A5Ac6ece32A4C172AE83390c2C59
# Where the API reaches the facilitator. Compose default is http://facilitator:3402.
FACILITATOR_URL=http://facilitator:3402
BTAI_CHAIN=quai
# BTAI_QUAI_SHARD_PREFIX=0x00
# BTAI_LOG_LEVEL=INFO
# BTAI_DB_PATH=/data/talent.db   (image default; mount a volume at /data)
# PORT=8000                       (Render/Railway/Fly inject this; honored by the image)

# ---- facilitator (packages/facilitator) -------------------------------------
# REQUIRED. The settlement key — it is the escrow's on-chain `agent`. Treat it as a
# hot wallet: fund it only with enough QUAI for gas, and rotate if it ever leaks.
FACILITATOR_PRIVATE_KEY=
# Allowlisted settlement tokens, lowercase, comma-separated:
SETTLEMENT_TOKENS=0x0049f7cbca3556c2dfae62aafa7015f99de1b8f5
# SETTLEMENT_TOKENS=0x0043a6b95a33a5ac6ece32a4c172ae83390c2c59
# QUAI_RPC_URL=https://rpc.quai.network
# FACILITATOR_CHAIN_ID=9         (15000 for Orchard)
# QUAI_SHARD_PREFIX=0x00
# MAX_TIMEOUT_SECONDS=300
# NONCE_DB_PATH=/data/facilitator-nonces.db   (image default; mount a volume at /data)
