# The escrow suite settles in real USDC, so it runs against a fork of a live
# chain. Point this at any Base mainnet RPC endpoint to enable the tests;
# without it `pnpm test` skips the suite instead of falling back to a mock token.
# The public endpoint works for this suite; any Base mainnet RPC will do.
BASE_RPC_URL=https://mainnet.base.org
# Pin the fork to a block for reproducible runs (optional).
FORK_BLOCK_NUMBER=
# Used only for the `base` / `baseSepolia` deploy networks.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
