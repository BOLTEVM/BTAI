# The escrow suite settles in real USDC, so it runs against a fork of a live
# chain. Point this at any Base mainnet RPC endpoint to enable the tests;
# without it `pnpm test` skips the suite instead of falling back to a mock token.
# The public endpoint works for this suite; any Base mainnet RPC will do.
BASE_RPC_URL=https://mainnet.base.org
# Pin the fork to a block for reproducible runs (optional).
FORK_BLOCK_NUMBER=
# Used only for the `base` / `baseSepolia` deploy networks.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
# QUAI networks (protobuf txs — deploy via quais.js scripts only).
QUAI_RPC_URL=https://rpc.quai.network
QUAI_ORCHARD_RPC_URL=https://orchard.rpc.quai.network
# Live deployments (2026-10-19), details in docs/QUAI_X402_TALENT_AGENCY_PLAN.md §5.1:
#   Orchard (15000):  escrow 0x0042bc0BBbe34FBa82a52Cce6a2792DaA87c484C
#                     token  0x0043a6b95A33A5Ac6ece32A4C172AE83390c2C59 (test USDT, mintable)
#   Mainnet (9):      escrow 0x00558035cfFAa4766A7f77cA987650711bDaF7a6
#                     token  0x0049F7cbCa3556C2DfaE62Aafa7015F99de1b8f5 (bridged USDT)
# QUAI gotchas: never send a legacy tx with an explicit EMPTY access list
# (mined execution burns all gas); use quais.QuaiTransaction, not plain objects.
